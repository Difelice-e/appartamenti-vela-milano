{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Appartamenti Vela Milano",
    "version": "1.0",
    "phase": "1",
    "tier": "plus",
    "source": "brand/guide.md",
    "date": "2026-04-18"
  },
  "color": {
    "primary": {
      "base": "#3A7D44",
      "hover": "#2F6939",
      "pressed": "#285B31"
    },
    "secondary": "#F6F4EC",
    "white": "#FFFFFF",
    "accent": {
      "base": "#D9B382",
      "hover": "#CEA373"
    },
    "neutralDark": "#1F2A24",
    "state": {
      "success": "#3A7D44",
      "warning": "#C68B4A",
      "error": "#B2453A"
    },
    "divider": {
      "soft": "rgba(31, 42, 36, 0.08)",
      "strong": "rgba(31, 42, 36, 0.18)"
    },
    "textOpacity": {
      "primary": 1,
      "secondary": 0.75,
      "min": 0.55
    }
  },
  "glass": {
    "bg": {
      "light": "rgba(255, 255, 255, 0.55)",
      "onPhoto": "rgba(246, 244, 236, 0.45)"
    },
    "border": "rgba(255, 255, 255, 0.35)",
    "blur": {
      "base": "40px",
      "onPhoto": "48px"
    },
    "saturate": {
      "base": "180%",
      "onPhoto": "200%"
    },
    "highlightInset": "inset 0 1px 0 rgba(255, 255, 255, 0.6)",
    "shadow": "0 12px 48px rgba(31, 42, 36, 0.12)",
    "fallback": {
      "bg": "#F6F4EC",
      "shadow": "0 8px 32px rgba(31, 42, 36, 0.10)"
    },
    "budget": {
      "maxLayersDesktop": 6,
      "maxLayersMobile": 4
    }
  },
  "typography": {
    "family": {
      "display": "Fraunces, Newsreader, Georgia, serif",
      "body": "Inter, system-ui, -apple-system, Segoe UI, sans-serif"
    },
    "displayAxes": {
      "Fraunces": ["opsz", "SOFT", "WONK"]
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "displayXL": {
        "font": "display",
        "size": "clamp(44px, 7vw, 72px)",
        "sizeDesktop": "72px",
        "weight": 400,
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em",
        "italic": true
      },
      "displayL": {
        "font": "display",
        "size": "clamp(36px, 5.5vw, 56px)",
        "sizeDesktop": "56px",
        "weight": 400,
        "lineHeight": 1.08,
        "letterSpacing": "-0.015em",
        "italic": true
      },
      "h1": {
        "font": "display",
        "size": "clamp(30px, 4.5vw, 44px)",
        "sizeDesktop": "44px",
        "weight": 500,
        "lineHeight": 1.1,
        "letterSpacing": "-0.012em"
      },
      "h2": {
        "font": "display",
        "size": "clamp(24px, 3.5vw, 32px)",
        "sizeDesktop": "32px",
        "weight": 500,
        "lineHeight": 1.15,
        "letterSpacing": "-0.01em"
      },
      "h3": {
        "font": "body",
        "size": "20px",
        "weight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "bodyL": {
        "font": "body",
        "size": "clamp(16px, 1.6vw, 18px)",
        "sizeDesktop": "18px",
        "weight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0"
      },
      "body": {
        "font": "body",
        "size": "16px",
        "weight": 400,
        "lineHeight": 1.55,
        "letterSpacing": "0"
      },
      "small": {
        "font": "body",
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "micro": {
        "font": "body",
        "size": "12px",
        "weight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.08em",
        "textTransform": "uppercase"
      }
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "48px",
      "10": "64px",
      "12": "96px",
      "16": "128px",
      "20": "160px"
    },
    "section": {
      "pyDesktop": "140px",
      "pyDesktopMin": "120px",
      "pyDesktopMax": "160px",
      "pyMobile": "90px",
      "pyMobileMin": "80px",
      "pyMobileMax": "100px"
    }
  },
  "layout": {
    "container": {
      "max": "1200px",
      "heroMax": "1280px"
    },
    "grid": {
      "desktop": { "cols": 12, "gutter": "24px" },
      "tablet": { "cols": 8, "gutter": "20px" },
      "mobile": { "cols": 4, "gutter": "16px" }
    },
    "nav": {
      "heightDesktop": "72px",
      "heightMobile": "64px"
    },
    "whitespaceRatio": "≥2:1"
  },
  "radius": {
    "xs": "14px",
    "sm": "18px",
    "md": "20px",
    "lg": "24px",
    "xl": "28px",
    "pill": "999px"
  },
  "shadow": {
    "cardSoft": "0 8px 32px rgba(31, 42, 36, 0.08)",
    "cardHover": "0 14px 48px rgba(31, 42, 36, 0.14)",
    "glass": "0 12px 48px rgba(31, 42, 36, 0.12)",
    "focusRing": "0 0 0 3px rgba(58, 125, 68, 0.15)"
  },
  "motion": {
    "easing": {
      "softOut": "cubic-bezier(0.16, 1, 0.3, 1)",
      "smoothInout": "cubic-bezier(0.65, 0, 0.35, 1)",
      "linear": "linear"
    },
    "duration": {
      "micro": "200ms",
      "card": "400ms",
      "reveal": "600ms",
      "hero": "1200ms"
    },
    "staggerDelay": "80ms",
    "parallax": {
      "allowed": ["hero-background", "one-divider-max"],
      "maxViewportShift": "12%",
      "mobile": "off"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1440px"
  },
  "zIndex": {
    "base": 0,
    "stickyNav": 40,
    "glassOverlay": 50,
    "modal": 90,
    "toast": 100
  },
  "iconography": {
    "family": "Phosphor Icons",
    "weight": "Regular",
    "stroke": "1.5px",
    "corners": "rounded",
    "color": ["--color-neutral-dark", "--color-primary"]
  },
  "accessibility": {
    "contrastMin": "WCAG AA 4.5:1",
    "respects": [
      "prefers-reduced-motion",
      "prefers-reduced-transparency"
    ]
  }
}
